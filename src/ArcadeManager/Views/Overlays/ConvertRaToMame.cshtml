@{
    ViewData["title"] = Localizer["OVERLAYS_RATOMAME_PAGETITLE"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="navmenu">@Localizer["HOME"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Overlays" asp-action="Index" class="navmenu">@Localizer["BREADCRUMB_OVERLAYS_INDEX"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["BREADCRUMB_OVERLAYS_CONVERT_RATOMAME"]</li>
    </ol>
</nav>

<h2>
    @Localizer["OVERLAYS_RATOMAME_PAGETITLE"]
</h2>

<p>
    @Html.Raw(Localizer["OVERLAYS_RATOMAME_INTRO"])
</p>

<!-- Path to the source roms folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="romsPath">@Localizer["OVERLAYS_RATOMAME_ROMS"]</label>
    </div>
    <input type="text" class="form-control" id="romsPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="romsPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_RATOMAME_ROMS_DESC"]</small>
</p>

<!-- Path to the source overlays folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="overlaysPath">@Localizer["OVERLAYS_RATOMAME_OVERLAYS"]</label>
    </div>
    <input type="text" class="form-control" id="overlaysPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="overlaysPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_RATOMAME_OVERLAYS_DESC"]</small>
</p>

<!-- Path to the target mame folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="targetPath">@Localizer["OVERLAYS_RATOMAME_TARGET"]</label>
    </div>
    <input type="text" class="form-control" id="targetPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="targetPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_RATOMAME_TARGET_DESC"]</small>
</p>

<!-- scan the bezel -->
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="scanbezel" id="scanbezelscan" value="yes" checked>
    <label class="form-check-label" for="scanbezelscan">@Localizer["OVERLAYS_SCANBEZEL_SCAN"]</label>
</div>
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="scanbezel" id="scanbezelconvert" value="no">
    <label class="form-check-label" for="scanbezelconvert">@Localizer["OVERLAYS_SCANBEZEL_CONVERT"]</label>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_SCANBEZEL_DESC"]</small>
</p>

<!-- Zip the result -->
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="zip" id="zipzip" value="yes" checked>
    <label class="form-check-label" for="zipzip">@Localizer["OVERLAYS_RATOMAME_ZIP_ZIP"]</label>
</div>
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="zip" id="zipunzip" value="no">
    <label class="form-check-label" for="zipunzip">@Localizer["OVERLAYS_RATOMAME_ZIP_UNZIP"]</label>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_RATOMAME_ZIP_DESC"]</small>
</p>

<!-- Resolution -->
<div class="input-group">
    <input type="text" class="form-control size-input" placeholder="@Localizer["OVERLAYS_WIDTH"]" id="width" value="1920" aria-label="@Localizer["OVERLAYS_WIDTH"]">
    <div class="input-group-append input-group-prepend">
        <span class="input-group-text">&times;</span>
    </div>
    <input type="text" class="form-control size-input" placeholder="@Localizer["OVERLAYS_HEIGHT"]" id="height" value="1080" aria-label="@Localizer["OVERLAYS_HEIGHT"]">
</div>
<div>
    <small>
        <a href="#" class="setsize" data-width="2560" data-height="1440">1440p</a>
        /
        <a href="#" class="setsize" data-width="1920" data-height="1080">1080p</a>
        /
        <a href="#" class="setsize" data-width="1280" data-height="720">720p</a>
    </small>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_SIZE_DESC"]</small>
</p>

<!-- Margin -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="margin">@Localizer["OVERLAYS_MARGIN"]</label>
    </div>
    <input type="text" class="form-control size-input" id="margin">
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_MARGIN_DESC"]</small>
</p>

<!-- Debug folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="debug">@Localizer["OVERLAYS_DEBUG"]</label>
    </div>
    <input type="text" class="form-control" id="debug">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="debug">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_DEBUG_DESC"]</small>
</p>

<!-- Overwrite -->
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="overwrite" id="overwriteYes" value="yes">
    <label class="form-check-label" for="overwriteYes">@Localizer["OVERWRITE_YES"]</label>
</div>
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="overwrite" id="overwriteNo" value="no" checked>
    <label class="form-check-label" for="overwriteNo">@Localizer["OVERWRITE_NO"]</label>
</div>

<!-- GO -->
<p class="mt-3">
    <button type="button" id="buttonOk" class="btn btn-primary btn-lg btn-block">@Localizer["OVERLAYS_CONVERT_GO"]</button>
</p>

@section Scripts {
<script>
$(() => {
    // handle click on resolution presets
    $('a.setsize').on('click', (e) => {
        let link = $(e.currentTarget);
        $('#width').val(link.data('width'));
        $('#height').val(link.data('height'));
    });

    // run
    $('#buttonOk').on('click', () => {
        // get paths from file inputs
        const sourceRoms = $('#romsPath').val(),
            sourceConfigs = $('#overlaysPath').val(),
            output = $('#targetPath').val(),
            scanBezelForScreenCoordinates = $('input[name=scanbezel]:checked').val() == 'yes' ? true : false,
            zip = $('input[name=zip]:checked').val() == 'yes' ? true : false,
            width = $('#width').val() || 1920,
            height = $('#height').val() || 1080,
            margin = $('#margin').val() || 0,
            outputDebug = $('#debug').val(),
            overwrite = $('input[name=overwrite]:checked').val() == 'yes' ? true : false;

        const targetResolution = `${width}x${height}`;

        // check every path is filled
        if (sourceRoms === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOSOURCEROM"))'); return; }
        if (sourceConfigs === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOSOURCECONFIG"))'); return; }
        if (output === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOTARGET"))'); return; }

        ipc("overlays-ratomame", { sourceRoms, sourceConfigs, output, zip, width, height, margin, outputDebug, overwrite, scanBezelForScreenCoordinates });
    });
});

</script>
}

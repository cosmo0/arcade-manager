@{
    ViewData["title"] = Localizer["OVERLAYS_MAMETORA_PAGETITLE"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="navmenu">@Localizer["HOME"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Overlays" asp-action="Index" class="navmenu">@Localizer["BREADCRUMB_OVERLAYS_INDEX"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["BREADCRUMB_OVERLAYS_CONVERT_MAMETORA"]</li>
    </ol>
</nav>

<h2>
    @Localizer["OVERLAYS_MAMETORA_PAGETITLE"]
</h2>

<p>
    @Html.Raw(Localizer["OVERLAYS_MAMETORA_INTRO"])
</p>

<!-- Path to the source folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="sourcePath">@Localizer["OVERLAYS_MAMETORA_SOURCE"]</label>
    </div>
    <input type="text" class="form-control" id="sourcePath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="sourcePath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_MAMETORA_SOURCE_DESC"]</small>
</p>

<!-- Path to the mame config folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="mameconfigPath">@Localizer["OVERLAYS_MAMETORA_MAMECONFIG"]</label>
    </div>
    <input type="text" class="form-control" id="mameconfigPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="mameconfigPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_MAMETORA_MAMECONFIG_DESC"]</small>
</p>

<!-- Path to the target roms folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="targetRoms">@Localizer["OVERLAYS_MAMETORA_TARGETROMS"]</label>
    </div>
    <input type="text" class="form-control" id="targetRoms">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="targetRoms">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_MAMETORA_TARGETROMS_DESC"]</small>
</p>

<!-- Path to the target configs folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="targetConfigs">@Localizer["OVERLAYS_MAMETORA_TARGETCONFIGS"]</label>
    </div>
    <input type="text" class="form-control" id="targetConfigs">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="targetConfigs">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_MAMETORA_TARGETCONFIGS_DESC"]</small>
</p>

<!-- scan the bezel -->
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="scanbezel" id="scanbezelscan" value="yes" checked>
    <label class="form-check-label" for="scanbezelscan">@Localizer["OVERLAYS_SCANBEZEL_SCAN"]</label>
</div>
<div class="form-check form-check-inline">
    <input class="form-check-input" type="radio" name="scanbezel" id="scanbezelconvert" value="no">
    <label class="form-check-label" for="scanbezelconvert">@Localizer["OVERLAYS_SCANBEZEL_CONVERT"]</label>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_SCANBEZEL_DESC"]</small>
</p>

<!-- Resolution -->
<partial name="_Resize.cshtml" />

<!-- Margin -->
<partial name="_Margin.cshtml" />

<!-- Debug folder -->
<partial name="_DebugFolder.cshtml" />

<!-- Overwrite -->
<partial name="/Views/Shared/_Overwrite.cshtml" />

<!-- GO -->
<p class="mt-3">
    <button type="button" id="buttonOk" class="btn btn-primary btn-lg btn-block">@Localizer["OVERLAYS_CONVERT_GO"]</button>
</p>

@section Scripts {
<script>
$(() => {
    // run
    $('#buttonOk').on('click', () => {
        // get paths from file inputs
        const source = $('#sourcePath').val(),
            sourceConfigs = $('#mameconfigPath').val(),
            outputRoms = $('#targetRoms').val(),
            outputOverlays = $('#targetConfigs').val(),
            scanBezelForScreenCoordinates = $('input[name=scanbezel]:checked').val() == 'yes' ? true : false,
            width = $('#width').val() || 1920,
            height = $('#height').val() || 1080,
            margin = $('#margin').val() || 0,
            outputDebug = $('#debug').val(),
            overwrite = $('input[name=overwrite]:checked').val() == 'yes' ? true : false;

        const targetResolution = `${width}x${height}`;

        // check every path is filled
        if (source === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOSOURCEROM"))'); return; }
        if (outputRoms === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOTARGET"))'); return; }
        if (outputOverlays === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOTARGET"))'); return; }

        ipc("overlays-mametora", { source, sourceConfigs, outputRoms, outputOverlays, targetResolution, margin, outputDebug, overwrite, scanBezelForScreenCoordinates });
    });
});

</script>
}

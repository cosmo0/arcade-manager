@{
    ViewData["title"] = Localizer["OVERLAYS_GENERATE_PAGETITLE"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="navmenu">@Localizer["HOME"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Overlays" asp-action="Index" class="navmenu">@Localizer["BREADCRUMB_OVERLAYS_INDEX"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["BREADCRUMB_OVERLAYS_GENERATE"]</li>
    </ol>
</nav>

<h2>
    @Localizer["OVERLAYS_GENERATE_PAGETITLE"]
</h2>

<p>
    @Html.Raw(Localizer["OVERLAYS_GENERATE_INTRO"])
</p>

<div class="alert alert-warning">
    @Html.Raw(Localizer["OVERLAYS_GENERATE_ONLYRA"])
</div>

<!-- Path to the images -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="imagesPath">@Localizer["OVERLAYS_GENERATE_IMAGES"]</label>
    </div>
    <input type="text" class="form-control" id="imagesPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="imagesPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_GENERATE_IMAGES_DESC"]</small>
</p>

<!-- Path to the roms folder -->
<div class="input-group mb-0">
    <div class="input-group-prepend">
        <label class="input-group-text" for="romsPath">@Localizer["OVERLAYS_GENERATE_ROMS"]</label>
    </div>
    <input type="text" class="form-control" id="romsPath">
    <div class="input-group-append">
        <button class="btn btn-outline-primary browse folder" type="button" data-input="romsPath">@Localizer["BROWSE"]</button>
    </div>
</div>
<p class="mt-0 mb-3">
    <small class="form-text text-muted">@Localizer["OVERLAYS_GENERATE_ROMS_DESC"]</small>
</p>

<!-- Resolution -->
<partial name="_Resize.cshtml" />

<!-- Margin -->
<partial name="_Margin.cshtml" />

<!-- Debug folder -->
<partial name="_DebugFolder.cshtml" />

<!-- Overwrite -->
<partial name="/Views/Shared/_Overwrite.cshtml" />

<!-- GO -->
<p class="mt-3">
    <button type="button" id="buttonOk" class="btn btn-primary btn-lg btn-block">@Localizer["OVERLAYS_GENERATE_GENERATE"]</button>
</p>

@section Scripts {
<script>
$(() => {
    // run
    $('#buttonOk').on('click', () => {
        // get paths from file inputs
        const imagesFolder = $('#imagesPath').val(),
            romsFolder = $('#romsPath').val(),
            width = $('#width').val() || 1920,
            height = $('#height').val() || 1080,
            margin = $('#margin').val() || 0,
            outputDebug = $('#debug').val(),
            overwrite = $('input[name=overwrite]:checked').val() == 'yes' ? true : false;

        const targetResolution = `${width}x${height}`;

        // check every path is filled
        if (imagesFolder === '') { window.alert('@Html.Raw(Localizer.Js("OVERLAYS_GENERATE_ERROR_NOIMAGE"))'); return; }
        if (romsFolder === '') { window.alert('@Html.Raw(Localizer.Js("ERROR_NOSELECTION"))'); return; }

        ipc("overlays-generate", { imagesFolder, romsFolder, targetResolution, margin, outputDebug, overwrite });
    });
});

</script>
}
